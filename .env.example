# ==============================================================================
# Centralized Network Monitoring System - Environment Configuration Example
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# NOTE: This project is designed for laboratory testing and academic evaluation.
# It is NOT hardened for production deployment.
# ==============================================================================

# Grafana Admin Credentials
# Change these values before deploying in an open lab network
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_lab_change_me

# Service Port Bindings (Host Ports)
PROMETHEUS_PORT=9090
SNMP_EXPORTER_PORT=9116
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
SNMP_SIMULATOR_PORT=161

# SNMP Simulation Parameters
# Note: Use only letters, numbers, underscores, or hyphens for SNMP_COMMUNITY
SNMP_COMMUNITY=public
SNMP_SYS_LOCATION=Lab Topology - Host A1
SNMP_SYS_CONTACT=lab-operator@example.local
